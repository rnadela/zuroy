generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Core Models ────────────────────────────────────

model Hotel {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  address        String?
  latitude       Float?   @db.DoublePrecision
  longitude      Float?   @db.DoublePrecision
  logoUrl        String?
  primaryColor   String?
  secondaryColor String?
  backgroundUrl    String?
  hotspotDataCapMb Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  rooms        Room[]
  devices      Device[]
  staff        User[]
  reservations Reservation[]
  amenities    Amenity[]
  serviceItems ServiceItem[]
  serviceRequests ServiceRequest[]
  stayExtensions  StayExtension[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @db.VarChar(255)
  firstName    String
  lastName     String
  role         Role     @default(HOTEL_STAFF)
  hotelId      String?
  hotel        Hotel?   @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([hotelId])
  @@index([role])
}

enum Role {
  SUPER_ADMIN
  HOTEL_STAFF
}

model Room {
  id           String        @id @default(cuid())
  number       String        @db.VarChar(20)
  floor        Int?
  type         String?
  hotelId      String
  hotel        Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([hotelId, number])
}

model Device {
  id             String       @id @default(cuid())
  serialNumber   String       @unique
  deviceModel    String?
  status         DeviceStatus @default(UNASSIGNED)
  hotelId        String?
  hotel          Hotel?       @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  enrollmentCode String?      @unique
  lastHeartbeat  DateTime?
  batteryLevel   Int?
  appVersion     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  reservations Reservation[]

  @@index([hotelId, status])
}

enum DeviceStatus {
  UNASSIGNED
  ASSIGNED
  ONLINE
  OFFLINE
  MAINTENANCE
}

model Reservation {
  id                         String            @id @default(cuid())
  guestName                  String
  guestEmail                 String?
  guestPhone                 String?
  hotelId                    String
  hotel                      Hotel             @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  roomId                     String
  room                       Room              @relation(fields: [roomId], references: [id], onDelete: Restrict)
  deviceId                   String?
  device                     Device?           @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  checkIn                    DateTime
  checkOut                   DateTime
  status                     ReservationStatus @default(PENDING)
  provisioningToken          String?           @unique
  provisioningTokenExpiresAt DateTime?
  hotspotSsid                String?
  hotspotPassword            String?
  hotspotEnabled             Boolean           @default(false)
  hotspotDataUsedMb          Int               @default(0)
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  serviceRequests ServiceRequest[]
  stayExtensions  StayExtension[]

  @@index([hotelId])
  @@index([hotelId, status, checkIn])
  @@index([roomId, checkIn, checkOut])
  @@index([status])
  @@index([deviceId])
}

enum ReservationStatus {
  PENDING
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

// ─── Service Models ─────────────────────────────────

model Amenity {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  latitude    Float?   @db.DoublePrecision
  longitude   Float?   @db.DoublePrecision
  hours       String?
  photoUrls   String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([hotelId, category])
}

model ServiceItem {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String
  price       Decimal  @db.Decimal(10, 2)
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  available   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  serviceRequests ServiceRequest[]

  @@index([hotelId, category])
}

model ServiceRequest {
  id            String               @id @default(cuid())
  reservationId String
  reservation   Reservation          @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  itemId        String
  item          ServiceItem          @relation(fields: [itemId], references: [id], onDelete: Restrict)
  hotelId       String
  hotel         Hotel                @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  quantity      Int                  @default(1)
  notes         String?
  status        ServiceRequestStatus @default(PENDING)
  chargeAmount  Decimal              @db.Decimal(10, 2)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([hotelId, status])
  @@index([reservationId])
}

enum ServiceRequestStatus {
  PENDING
  COMPLETED
  CANCELLED
}

// ─── Partner Models ─────────────────────────────────

model Partner {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String
  latitude    Float    @db.DoublePrecision
  longitude   Float    @db.DoublePrecision
  address     String?
  phone       String?
  website     String?
  hours       String?
  photoUrls   String[]
  boosted     Boolean  @default(false)
  boostRegion String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([latitude, longitude])
  @@index([boosted])
}

// ─── Stay Extension ─────────────────────────────────

model StayExtension {
  id            String              @id @default(cuid())
  reservationId String
  reservation   Reservation         @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  hotelId       String
  hotel         Hotel               @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  newCheckOut   DateTime
  reason        String?
  status        StayExtensionStatus @default(PENDING)
  rejectionNote String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([hotelId, status])
  @@index([reservationId])
}

enum StayExtensionStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── Audit Log ──────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  actorRole  String?
  action     String
  resource   String
  resourceId String?
  hotelId    String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([resource, resourceId])
  @@index([hotelId])
  @@index([createdAt])
}
