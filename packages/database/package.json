{
  "name": "@zuroy/database",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs --dts --outDir dist --external @prisma/client --external ../generated/client",
    "dev": "tsup src/index.ts --format cjs --dts --outDir dist --external @prisma/client --external ../generated/client --watch",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6",
    "prisma": "^6"
  }
}
