{
  "name": "zuroy",
  "version": "0.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "nohoist": [
      "**/react-native",
      "**/react-native/**",
      "**/expo",
      "**/expo/**"
    ]
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "lint:fix": "turbo lint -- --fix",
    "format": "prettier --write .",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:studio": "yarn workspace @zuroy/database db:studio",
    "ship": "bash scripts/deploy.sh"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "prettier": "^3",
    "tsup": "^8.5.1",
    "turbo": "^2",
    "typescript": "^5.5"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@1.22.22"
}
